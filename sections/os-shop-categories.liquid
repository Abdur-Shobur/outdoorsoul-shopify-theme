{{ 'slick.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign view_all_url = section.settings.view_all_link
  if view_all_url == blank
    assign view_all_url = routes.collections_url
  endif
-%}

<section
  id="OsCategories-{{ section.id }}"
  class="os-categories{% if section.settings.overlap_hero %} os-categories--overlap{% endif %}"
  style="
    --os-cat-pad-top: {{ section.settings.padding_top }}px;
    --os-cat-pad-bottom: {{ section.settings.padding_bottom }}px;
  "
  aria-labelledby="OsCategoriesHeading-{{ section.id }}"
>
  <div class="os-container">
    <div class="os-categories__panel">
      <div class="os-categories__header">
        {%- if section.settings.title != blank -%}
          <h2 id="OsCategoriesHeading-{{ section.id }}" class="os-categories__title">
            {{ section.settings.title | escape }}
          </h2>
        {%- endif -%}

        {%- if section.settings.show_view_all -%}
          <a href="{{ view_all_url }}" class="os-categories__view-all">
            <span>{{ section.settings.view_all_label | default: 'View All' | escape }}</span>
            <span class="os-categories__view-all-extra">{{ section.settings.view_all_suffix | escape }}</span>
            <span class="svg-wrapper" aria-hidden="true">
              {{- 'icon-arrow.svg' | inline_asset_content -}}
            </span>
          </a>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <div
          class="os-categories__slider"
          data-os-categories-slick
          data-slides-desktop="{{ section.settings.slides_desktop }}"
          data-slides-tablet="{{ section.settings.slides_tablet }}"
          data-slides-mobile="{{ section.settings.slides_mobile }}"
        >
          {%- for block in section.blocks -%}
            {%- liquid
              assign collection = block.settings.collection
              assign title = block.settings.title
              if title == blank and collection != blank
                assign title = collection.title
              endif
              assign link_url = block.settings.link
              if link_url == blank and collection != blank
                assign link_url = collection.url
              endif
              assign image = block.settings.image
              if image == blank and collection != blank
                assign image = collection.featured_image
              endif
            -%}
            <div class="os-categories__item" {{ block.shopify_attributes }}>
              <a
                class="os-categories__card"
                {% if link_url != blank %}
                  href="{{ link_url }}"
                {% else %}
                  role="link"
                  aria-disabled="true"
                {% endif %}
              >
                <span class="os-categories__media">
                  {%- if image != blank -%}
                    {{
                      image
                      | image_url: width: 280
                      | image_tag:
                        class: 'os-categories__image',
                        loading: 'lazy',
                        widths: '120, 160, 200, 280',
                        sizes: '(min-width: 990px) 7rem, 6.5rem',
                        alt: title
                    }}
                  {%- else -%}
                    <span class="os-categories__image os-categories__image--placeholder" aria-hidden="true">
                      {{ 'collection-1' | placeholder_svg_tag }}
                    </span>
                  {%- endif -%}
                </span>
                {%- if title != blank -%}
                  <span class="os-categories__label">{{ title | escape }}</span>
                {%- endif -%}
              </a>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  <script src="{{ 'jquery.min.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'slick.min.js' | asset_url }}" defer="defer"></script>
</section>

{% schema %}
{
  "name": "Shop by Category",
  "tag": "section",
  "class": "section-os-categories",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Shop by Category"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show view all link",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all label",
      "default": "View All"
    },
    {
      "type": "text",
      "id": "view_all_suffix",
      "label": "View all suffix (desktop)",
      "default": "Categories"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View all link",
      "info": "Defaults to all collections"
    },
    {
      "type": "checkbox",
      "id": "overlap_hero",
      "label": "Overlap hero banner",
      "default": true
    },
    {
      "type": "header",
      "content": "Slider"
    },
    {
      "type": "range",
      "id": "slides_desktop",
      "min": 4,
      "max": 8,
      "step": 1,
      "label": "Slides on desktop",
      "default": 7
    },
    {
      "type": "range",
      "id": "slides_tablet",
      "min": 3,
      "max": 6,
      "step": 1,
      "label": "Slides on tablet",
      "default": 4
    },
    {
      "type": "range",
      "id": "slides_mobile",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Slides on mobile",
      "default": 3
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom title",
          "info": "Defaults to collection title"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image",
          "info": "Defaults to collection image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom link",
          "info": "Defaults to collection URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by Category",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
