<section
  id="OsNewsletter-{{ section.id }}"
  class="os-newsletter"
  style="
    --os-news-pad-top: {{ section.settings.padding_top }}px;
    --os-news-pad-bottom: {{ section.settings.padding_bottom }}px;
  "
  {% if section.settings.heading != blank %}
    aria-labelledby="OsNewsletterHeading-{{ section.id }}"
  {% endif %}
>
  <div class="os-container">
    <div class="os-newsletter__panel">
      <div class="os-newsletter__copy">
        {%- if section.settings.heading != blank -%}
          <h2 id="OsNewsletterHeading-{{ section.id }}" class="os-newsletter__heading">
            {{ section.settings.heading | escape }}
          </h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="os-newsletter__text rte">
            {{ section.settings.text }}
          </div>
        {%- endif -%}
      </div>

      <div class="os-newsletter__form-wrap">
        {%- form 'customer', class: 'os-newsletter__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">

          <div class="os-newsletter__field">
            <label class="visually-hidden" for="OsNewsletterEmail-{{ section.id }}">
              {{ 'newsletter.label' | t }}
            </label>
            <input
              id="OsNewsletterEmail-{{ section.id }}"
              type="email"
              name="contact[email]"
              class="os-newsletter__input"
              value="{{ form.email }}"
              aria-required="true"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              placeholder="{{ section.settings.placeholder | default: 'Enter your email' | escape }}"
              required
              {% if form.errors %}
                autofocus
                aria-invalid="true"
                aria-describedby="OsNewsletterError-{{ section.id }}"
              {% elsif form.posted_successfully? %}
                aria-describedby="OsNewsletterSuccess-{{ section.id }}"
              {% endif %}
            >
            <button
              type="submit"
              class="os-newsletter__button"
              name="commit"
              aria-label="{{ 'newsletter.button_label' | t }}"
            >
              <span class="os-newsletter__button-label">
                {{ section.settings.button_label | default: 'Subscribe' | escape }}
              </span>
              <span class="svg-wrapper" aria-hidden="true">
                {{- 'icon-arrow.svg' | inline_asset_content -}}
              </span>
            </button>
          </div>

          {%- if form.errors -%}
            <p class="os-newsletter__message os-newsletter__message--error" id="OsNewsletterError-{{ section.id }}" role="alert">
              <span class="svg-wrapper" aria-hidden="true">
                {{- 'icon-error.svg' | inline_asset_content -}}
              </span>
              {{- form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email -}}
            </p>
          {%- endif -%}

          {%- if form.posted_successfully? -%}
            <p
              class="os-newsletter__message os-newsletter__message--success"
              id="OsNewsletterSuccess-{{ section.id }}"
              tabindex="-1"
              autofocus
              role="status"
            >
              <span class="svg-wrapper" aria-hidden="true">
                {{- 'icon-success.svg' | inline_asset_content -}}
              </span>
              {{- 'newsletter.success' | t -}}
            </p>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Email signup",
  "tag": "section",
  "class": "section-os-newsletter",
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Customers who subscribe will have their email address added to the “accepts marketing” list."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Subscribe to our emails"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Be the first to know about new collections and exclusive offers.</p>"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Email placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Subscribe"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Email signup"
    }
  ]
}
{% endschema %}
