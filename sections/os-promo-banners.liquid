{%- liquid
  assign columns = section.settings.columns | default: 3
-%}

<section
  id="OsPromo-{{ section.id }}"
  class="os-promo os-promo--cols-{{ columns }}"
  style="
    --os-promo-pad-top: {{ section.settings.padding_top }}px;
    --os-promo-pad-bottom: {{ section.settings.padding_bottom }}px;
    --os-promo-cols: {{ columns }};
  "
  {% if section.settings.heading != blank %}
    aria-labelledby="OsPromoHeading-{{ section.id }}"
  {% endif %}
>
  <div class="os-container">
    {%- if section.settings.heading != blank -%}
      <div class="os-promo__header">
        <h2 id="OsPromoHeading-{{ section.id }}" class="os-promo__heading">
          {{ section.settings.heading | escape }}
        </h2>
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="os-promo__grid" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign link_url = block.settings.link
            assign image = block.settings.image
            assign title = block.settings.title
            assign text = block.settings.text
            assign image_alt = title
            if image != blank and image.alt != blank
              assign image_alt = image.alt
            endif
          -%}
          <li class="os-promo__item" {{ block.shopify_attributes }}>
            <a
              class="os-promo__card"
              {% if link_url != blank %}
                href="{{ link_url }}"
              {% else %}
                role="link"
                aria-disabled="true"
              {% endif %}
            >
              <span class="os-promo__media">
                {%- if image != blank -%}
                  {{
                    image
                    | image_url: width: 900
                    | image_tag:
                      class: 'os-promo__image',
                      loading: 'lazy',
                      widths: '360, 540, 720, 900',
                      sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw',
                      alt: image_alt
                  }}
                {%- else -%}
                  {{ 'collection-1' | placeholder_svg_tag: 'os-promo__image os-promo__image--placeholder' }}
                {%- endif -%}
              </span>
              <span class="os-promo__body">
                {%- if title != blank -%}
                  <span class="os-promo__title">{{ title | escape }}</span>
                {%- endif -%}
                {%- if text != blank -%}
                  <span class="os-promo__text">
                    {{ text | escape }}
                    <span class="svg-wrapper" aria-hidden="true">
                      {{- 'icon-arrow.svg' | inline_asset_content -}}
                    </span>
                  </span>
                {%- endif -%}
              </span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Promo banners",
  "tag": "section",
  "class": "section-os-promo",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Desktop columns",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" }
      ],
      "default": "3"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "promo",
      "name": "Promo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Promo title"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Shop the offer"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Promo banners",
      "blocks": [
        {
          "type": "promo",
          "settings": {
            "title": "Wilkinson Sword",
            "text": "Trusted garden tools"
          }
        },
        {
          "type": "promo",
          "settings": {
            "title": "Wolf-Garten",
            "text": "German-engineered quality"
          }
        },
        {
          "type": "promo",
          "settings": {
            "title": "Pruners & shears",
            "text": "Shop bestsellers"
          }
        }
      ]
    }
  ]
}
{% endschema %}
