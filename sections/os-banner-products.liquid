{%- if section.settings.enable_quick_add -%}
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- liquid
  assign collection = section.settings.collection
  assign products_to_show = section.settings.products_to_show | default: 3
  assign banner_image = section.settings.banner_image
  assign banner_heading = section.settings.banner_heading
  assign banner_text = section.settings.banner_text
  assign banner_label = section.settings.banner_button_label
  assign banner_link = section.settings.banner_link
  assign banner_alt = banner_heading
  if banner_image != blank and banner_image.alt != blank
    assign banner_alt = banner_image.alt
  endif
  assign layout = section.settings.layout | default: 'banner_left'
-%}

<div
  id="OsBannerProducts-{{ section.id }}"
  class="os-banner-products os-banner-products--{{ layout }}"
  style="
    --os-bp-pad-top: {{ section.settings.padding_top }}px;
    --os-bp-pad-bottom: {{ section.settings.padding_bottom }}px;
  "
  {% if section.settings.title != blank %}
    aria-labelledby="OsBannerProductsHeading-{{ section.id }}"
  {% endif %}
>
  <div class="os-container">
    {%- if section.settings.title != blank or section.settings.show_view_all -%}
      <div class="os-banner-products__header">
        {%- if section.settings.title != blank -%}
          <h2 id="OsBannerProductsHeading-{{ section.id }}" class="os-banner-products__title">
            {{ section.settings.title | escape }}
          </h2>
        {%- endif -%}

        {%- if section.settings.show_view_all -%}
          {%- liquid
            assign view_all_url = section.settings.view_all_link
            if view_all_url == blank and collection != blank
              assign view_all_url = collection.url
            endif
          -%}
          {%- if view_all_url != blank -%}
            <a href="{{ view_all_url }}" class="os-banner-products__view-all">
              <span>{{ section.settings.view_all_label | default: 'View All' | escape }}</span>
              <span class="svg-wrapper" aria-hidden="true">
                {{- 'icon-arrow.svg' | inline_asset_content -}}
              </span>
            </a>
          {%- endif -%}
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="os-banner-products__layout">
      <aside class="os-banner-products__banner">
        {%- if banner_link != blank -%}
          <a class="os-banner-products__banner-link" href="{{ banner_link }}">
        {%- else -%}
          <div class="os-banner-products__banner-link">
        {%- endif -%}
          <span class="os-banner-products__banner-media">
            {%- if banner_image != blank -%}
              {{
                banner_image
                | image_url: width: 1200
                | image_tag:
                  class: 'os-banner-products__banner-image',
                  loading: 'lazy',
                  widths: '480, 720, 960, 1200',
                  sizes: '(min-width: 990px) 34vw, 100vw',
                  alt: banner_alt
              }}
            {%- else -%}
              {{ 'lifestyle-2' | placeholder_svg_tag: 'os-banner-products__banner-image os-banner-products__banner-image--placeholder' }}
            {%- endif -%}
          </span>
          <span class="os-banner-products__banner-body">
            {%- if section.settings.banner_eyebrow != blank -%}
              <span class="os-banner-products__banner-eyebrow">{{ section.settings.banner_eyebrow | escape }}</span>
            {%- endif -%}
            {%- if banner_heading != blank -%}
              <span class="os-banner-products__banner-heading">{{ banner_heading | escape }}</span>
            {%- endif -%}
            {%- if banner_text != blank -%}
              <span class="os-banner-products__banner-text">{{ banner_text | escape }}</span>
            {%- endif -%}
            {%- if banner_label != blank -%}
              <span class="os-banner-products__banner-cta">
                {{ banner_label | escape }}
                <span class="svg-wrapper" aria-hidden="true">
                  {{- 'icon-arrow.svg' | inline_asset_content -}}
                </span>
              </span>
            {%- endif -%}
          </span>
        {%- if banner_link != blank -%}
          </a>
        {%- else -%}
          </div>
        {%- endif -%}
      </aside>

      <div class="os-banner-products__products">
        {%- if collection != blank and collection.products_count > 0 -%}
          <ul class="os-banner-products__grid" role="list">
            {%- for product in collection.products limit: products_to_show -%}
              <li class="os-banner-products__item">
                {% render 'os-product-card',
                  product: product,
                  section: section,
                  show_vendor: section.settings.show_vendor,
                  show_rating: section.settings.show_rating,
                  enable_quick_add: section.settings.enable_quick_add
                %}
              </li>
            {%- endfor -%}
          </ul>
        {%- else -%}
          <div class="os-banner-products__empty">
            <p>Select a collection with products in the theme editor.</p>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Banner + products",
  "tag": "section",
  "class": "section-os-banner-products",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section heading",
      "default": "Featured picks"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "banner_left", "label": "Banner left / products right" },
        { "value": "banner_right", "label": "Products left / banner right" }
      ],
      "default": "banner_left"
    },
    {
      "type": "header",
      "content": "Ad banner"
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner image"
    },
    {
      "type": "text",
      "id": "banner_eyebrow",
      "label": "Banner eyebrow",
      "default": "Offer"
    },
    {
      "type": "text",
      "id": "banner_heading",
      "label": "Banner heading",
      "default": "Spring garden deals"
    },
    {
      "type": "textarea",
      "id": "banner_text",
      "label": "Banner text",
      "default": "Save on essential tools for the season ahead."
    },
    {
      "type": "text",
      "id": "banner_button_label",
      "label": "Banner button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "banner_link",
      "label": "Banner link"
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Products to show",
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show view all link",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all label",
      "default": "View All"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View all link",
      "info": "Defaults to the selected collection"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor instead of description",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show product rating",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_quick_add",
      "label": "Enable quick add button",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Banner + products"
    }
  ]
}
{% endschema %}
