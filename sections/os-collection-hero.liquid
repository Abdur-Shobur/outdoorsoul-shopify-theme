{%- liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = collection.title
  endif
  assign image = section.settings.image
  if image == blank and collection.image
    assign image = collection.image
  endif
  assign image_alt = heading
  if image != blank and image.alt != blank
    assign image_alt = image.alt
  endif
-%}

<div
  id="OsCollectionHero-{{ section.id }}"
  class="os-collection-hero{% if image != blank %} os-collection-hero--has-image{% endif %}"
  style="
    --os-col-hero-min-h: {{ section.settings.min_height }}px;
    --os-col-hero-min-h-mobile: {{ section.settings.min_height_mobile }}px;
    --os-col-hero-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  "
>
  {%- if image != blank -%}
    <div class="os-collection-hero__media" aria-hidden="true">
      {{
        image
        | image_url: width: 2400
        | image_tag:
          class: 'os-collection-hero__image',
          widths: '750, 1100, 1600, 2000, 2400',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          alt: ''
      }}
    </div>
  {%- endif -%}

  <div class="os-collection-hero__inner">
    <h1 class="os-collection-hero__title">{{ heading | escape }}</h1>
  </div>
</div>

{% schema %}
{
  "name": "Collection hero",
  "tag": "section",
  "class": "section-os-collection-hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Defaults to the collection title"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image",
      "info": "Defaults to the collection image. Full-bleed behind the centered title."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Image overlay",
      "default": 55
    },
    {
      "type": "range",
      "id": "min_height",
      "min": 180,
      "max": 600,
      "step": 10,
      "unit": "px",
      "label": "Minimum height (desktop)",
      "default": 450
    },
    {
      "type": "range",
      "id": "min_height_mobile",
      "min": 140,
      "max": 400,
      "step": 10,
      "unit": "px",
      "label": "Minimum height (mobile)",
      "default": 200
    }
  ],
  "presets": [
    {
      "name": "Collection hero"
    }
  ]
}
{% endschema %}
