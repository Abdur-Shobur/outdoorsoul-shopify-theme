{% doc %}
  @prompt
    Create a full-width search bar section that replicates a prominent header search input. It should have a white/light grey background, a wide rounded pill-shaped input field with a magnifying glass SVG icon on the left inside the input, and placeholder text "I'm looking for...". The search bar should be horizontally centred, take up most of the header width, have a subtle border, and submit to the store's native search results page (/search?q=). Make it responsive and style it to feel clean and modern, suitable for a garden and outdoor products store.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-search-bar-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_vertical }}px 0;
  }

  .ai-search-bar-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-search-bar-form-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
  }

  .ai-search-bar-input-wrapper-{{ ai_gen_id }} {
    position: relative;
    display: flex;
    align-items: center;
    background-color: {{ block.settings.input_background_color }};
    border: {{ block.settings.border_thickness }}px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .ai-search-bar-input-wrapper-{{ ai_gen_id }}:focus-within {
    border-color: {{ block.settings.focus_border_color }};
    box-shadow: 0 0 0 3px {{ block.settings.focus_border_color | color_modify: 'alpha', 0.1 }};
  }

  .ai-search-bar-icon-{{ ai_gen_id }} {
    position: absolute;
    left: {{ block.settings.icon_spacing }}px;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    color: {{ block.settings.icon_color }};
    z-index: 1;
  }

  .ai-search-bar-icon-{{ ai_gen_id }} svg {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
  }

  .ai-search-bar-input-{{ ai_gen_id }} {
    width: 100%;
    padding: {{ block.settings.input_padding_vertical }}px {{ block.settings.input_padding_horizontal }}px;
    padding-left: calc({{ block.settings.icon_spacing }}px + {{ block.settings.icon_size }}px + {{ block.settings.icon_spacing }}px);
    border: none;
    background: transparent;
    font-size: {{ block.settings.font_size }}px;
    color: {{ block.settings.text_color }};
    outline: none;
    font-family: inherit;
  }

  .ai-search-bar-input-{{ ai_gen_id }}::placeholder {
    color: {{ block.settings.placeholder_color }};
    opacity: 1;
  }

  .ai-search-bar-submit-{{ ai_gen_id }} {
    position: absolute;
    right: {{ block.settings.button_spacing }}px;
    top: 50%;
    transform: translateY(-50%);
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.2s ease;
    font-family: inherit;
  }

  .ai-search-bar-submit-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-search-bar-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_vertical | times: 0.7 }}px 0;
    }

    .ai-search-bar-container-{{ ai_gen_id }} {
      padding: 0 16px;
    }

    .ai-search-bar-input-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size | times: 0.9 }}px;
      padding-right: {{ block.settings.input_padding_horizontal | times: 0.8 }}px;
    }

    .ai-search-bar-submit-{{ ai_gen_id }} {
      padding: {{ block.settings.button_padding_vertical | times: 0.8 }}px {{ block.settings.button_padding_horizontal | times: 0.8 }}px;
      font-size: {{ block.settings.button_font_size | times: 0.9 }}px;
    }

    .ai-search-bar-icon-{{ ai_gen_id }} svg {
      width: {{ block.settings.icon_size | times: 0.9 }}px;
      height: {{ block.settings.icon_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<search-bar-{{ ai_gen_id }} class="ai-search-bar-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-search-bar-container-{{ ai_gen_id }}">
    <form action="/search" method="get" role="search" class="ai-search-bar-form-{{ ai_gen_id }}">
      <div class="ai-search-bar-input-wrapper-{{ ai_gen_id }}">
        <div class="ai-search-bar-icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.35-4.35"></path>
          </svg>
        </div>
        <input
          type="search"
          name="q"
          class="ai-search-bar-input-{{ ai_gen_id }}"
          placeholder="{{ block.settings.placeholder_text }}"
          aria-label="Search"
          autocomplete="off"
        >
        {% if block.settings.show_submit_button %}
          <button type="submit" class="ai-search-bar-submit-{{ ai_gen_id }}">
            {{ block.settings.button_text }}
          </button>
        {% endif %}
      </div>
    </form>
  </div>
</search-bar-{{ ai_gen_id }}>

<script>
  (function() {
    class SearchBar{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.form = this.querySelector('.ai-search-bar-form-{{ ai_gen_id }}');
        this.input = this.querySelector('.ai-search-bar-input-{{ ai_gen_id }}');
        
        if (this.form && this.input) {
          this.form.addEventListener('submit', this.handleSubmit.bind(this));
        }
      }

      handleSubmit(event) {
        if (!this.input.value.trim()) {
          event.preventDefault();
          this.input.focus();
        }
      }
    }

    customElements.define('search-bar-{{ ai_gen_id }}', SearchBar{{ ai_gen_id }});
  })();
</script>

