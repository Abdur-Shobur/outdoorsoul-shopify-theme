{% doc %}
  @prompt
    I want a black border to the filter buttons with rounded cornors and a white background.  Can the filter bar have a muted grey background
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-filter-bar-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-filter-bar-container-{{ ai_gen_id }} {
    background-color: {{ block.settings.filter_bar_background }};
    padding: {{ block.settings.filter_bar_padding }}px;
    border-radius: {{ block.settings.filter_bar_radius }}px;
  }

  .ai-filter-bar-heading-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
  }

  .ai-filter-buttons-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: {{ block.settings.button_gap }}px;
  }

  .ai-filter-button-{{ ai_gen_id }} {
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
    display: inline-block;
  }

  .ai-filter-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }

  .ai-filter-button-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.button_active_background }};
    color: {{ block.settings.button_active_text_color }};
    border-color: {{ block.settings.button_active_border_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-filter-bar-container-{{ ai_gen_id }} {
      padding: {{ block.settings.filter_bar_padding | times: 0.75 }}px;
    }

    .ai-filter-button-{{ ai_gen_id }} {
      font-size: {{ block.settings.button_font_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<collection-filter-bar-{{ ai_gen_id }}
  class="ai-filter-bar-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-filter-bar-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h3 class="ai-filter-bar-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h3>
    {% endif %}

    <div class="ai-filter-buttons-{{ ai_gen_id }}">
      {% if block.settings.show_all_button %}
        <button
          class="ai-filter-button-{{ ai_gen_id }} active"
          data-filter="all"
        >
          {{ block.settings.all_button_text }}
        </button>
      {% endif %}

      {% if block.settings.filter_1_enabled and block.settings.filter_1_label != blank %}
        <button
          class="ai-filter-button-{{ ai_gen_id }}"
          data-filter="filter-1"
        >
          {{ block.settings.filter_1_label }}
        </button>
      {% endif %}

      {% if block.settings.filter_2_enabled and block.settings.filter_2_label != blank %}
        <button
          class="ai-filter-button-{{ ai_gen_id }}"
          data-filter="filter-2"
        >
          {{ block.settings.filter_2_label }}
        </button>
      {% endif %}

      {% if block.settings.filter_3_enabled and block.settings.filter_3_label != blank %}
        <button
          class="ai-filter-button-{{ ai_gen_id }}"
          data-filter="filter-3"
        >
          {{ block.settings.filter_3_label }}
        </button>
      {% endif %}

      {% if block.settings.filter_4_enabled and block.settings.filter_4_label != blank %}
        <button
          class="ai-filter-button-{{ ai_gen_id }}"
          data-filter="filter-4"
        >
          {{ block.settings.filter_4_label }}
        </button>
      {% endif %}

      {% if block.settings.filter_5_enabled and block.settings.filter_5_label != blank %}
        <button
          class="ai-filter-button-{{ ai_gen_id }}"
          data-filter="filter-5"
        >
          {{ block.settings.filter_5_label }}
        </button>
      {% endif %}

      {% if block.settings.filter_6_enabled and block.settings.filter_6_label != blank %}
        <button
          class="ai-filter-button-{{ ai_gen_id }}"
          data-filter="filter-6"
        >
          {{ block.settings.filter_6_label }}
        </button>
      {% endif %}
    </div>
  </div>
</collection-filter-bar-{{ ai_gen_id }}>

<script>
  (function() {
    class CollectionFilterBar{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.buttons = this.querySelectorAll('.ai-filter-button-{{ ai_gen_id }}');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.buttons.forEach((button) => {
          button.addEventListener('click', () => {
            this.buttons.forEach((btn) => btn.classList.remove('active'));
            button.classList.add('active');
            
            const filterValue = button.getAttribute('data-filter');
            this.dispatchEvent(new CustomEvent('filter-change', {
              detail: { filter: filterValue },
              bubbles: true
            }));
          });
        });
      }
    }

    customElements.define('collection-filter-bar-{{ ai_gen_id }}', CollectionFilterBar{{ ai_gen_id }});
  })();
</script>

