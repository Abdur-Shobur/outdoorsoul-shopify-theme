{% doc %}
  @prompt
    Create a collection description section that dynamically displays the current collection's description using {{ collection.description }}. It should appear as a clean text block below the product grid on collection pages, with some padding and support for HTML formatting in the description.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-description-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-collection-description-content-{{ ai_gen_id }} {
    font-size: {{ block.settings.font_size }}px;
    line-height: {{ block.settings.line_height }};
  }

  .ai-collection-description-content-{{ ai_gen_id }} p {
    margin: 0 0 1em;
  }

  .ai-collection-description-content-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-collection-description-content-{{ ai_gen_id }} h1,
  .ai-collection-description-content-{{ ai_gen_id }} h2,
  .ai-collection-description-content-{{ ai_gen_id }} h3,
  .ai-collection-description-content-{{ ai_gen_id }} h4,
  .ai-collection-description-content-{{ ai_gen_id }} h5,
  .ai-collection-description-content-{{ ai_gen_id }} h6 {
    margin: 0 0 0.5em;
  }

  .ai-collection-description-content-{{ ai_gen_id }} ul,
  .ai-collection-description-content-{{ ai_gen_id }} ol {
    margin: 0 0 1em;
    padding-left: 1.5em;
  }

  .ai-collection-description-content-{{ ai_gen_id }} a {
    color: {{ block.settings.link_color }};
    text-decoration: underline;
  }

  .ai-collection-description-content-{{ ai_gen_id }} a:hover {
    opacity: 0.8;
  }

  .ai-collection-description-empty-{{ ai_gen_id }} {
    font-size: 14px;
    color: #999;
    font-style: italic;
    padding: 20px;
  }

  @media screen and (max-width: 749px) {
    .ai-collection-description-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top | times: 0.7 }}px {{ block.settings.padding_horizontal | times: 0.7 }}px {{ block.settings.padding_bottom | times: 0.7 }}px;
    }

    .ai-collection-description-content-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<collection-description-{{ ai_gen_id }}
  class="ai-collection-description-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  {% if collection.description != blank %}
    <div class="ai-collection-description-content-{{ ai_gen_id }}">
      {{ collection.description }}
    </div>
  {% else %}
    <div class="ai-collection-description-empty-{{ ai_gen_id }}">
      Add a description to this collection in the admin panel
    </div>
  {% endif %}
</collection-description-{{ ai_gen_id }}>

<script>
  (function() {
    class CollectionDescription{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }
    }

    customElements.define('collection-description-{{ ai_gen_id }}', CollectionDescription{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Collection description",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Horizontal padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "line_height",
      "label": "Line height",
      "min": 1,
      "max": 2,
      "step": 0.1,
      "default": 1.6
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Links",
      "default": "#459a2b"
    }
  ],
  "presets": [
    {
      "name": "Collection description"
    }
  ]
}
{% endschema %}
