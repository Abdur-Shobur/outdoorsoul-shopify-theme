    },
    {
      "type": "header",
      "content": "Input field"
    },
    {
      "type": "text",
      "id": "placeholder_text",
      "label": "Placeholder text",
      "default": "I'm looking for..."
    },
    {
      "type": "range",
      "id": "input_padding_vertical",
      "label": "Vertical padding",
      "min": 8,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "input_padding_horizontal",
