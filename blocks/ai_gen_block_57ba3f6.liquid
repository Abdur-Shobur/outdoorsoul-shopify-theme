      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#6b7280"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "placeholder_color",
      "label": "Placeholder",
      "default": "#9ca3af"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#d1d5db"
    },
    {
      "type": "color",
      "id": "focus_border_color",
      "label": "Focus border",
      "default": "#459a2b"
    },
    {
      "type": "color",
      "id": "focus_ring_color",
      "label": "Focus ring",
      "default": "rgba(69, 154, 43, 0.2)"
    },
    {
      "type": "range",
      "id": "focus_ring_width",
      "label": "Focus ring width",
      "min": 0,
      "max": 6,
      "step": 1,
      "unit": "px",
      "default": 3
    }
  ],
  "presets": [
    {
      "name": "Search bar"
    }
  ]
}
{% endschema %}